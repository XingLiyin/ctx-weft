{# Framework-owned index layout; provider names, descriptions and schemas are opaque data.
   Rendered order: skills / tools / sub-agents; each section has ungrouped items first,
   then provider headings, descriptions, prefix instructions and item lists. #}
{%- macro items(values, signature) -%}
{% for item in values %}
- {{ item.name }}{% if signature %}({{ item.signature }}){% else %}: {{ item.description }}{% endif %}{% endfor %}
{%- endmacro -%}
{%- set vocabulary = {
  'skill': ('skills', 'assigning', 'skill', 'skills'),
  'tool': ('tools', 'calling', 'tool', 'tools'),
  'agent': ('subagents', 'delegating', 'sub-agent', 'sub-agents')
} -%}
{%- for section in sections -%}
{% set heading, action, noun, noun_plural = vocabulary[section.kind] -%}
{{ headings[heading] }}{% if section.kind == 'tool' %}
{% include 'common/tools_index_preamble.en.jinja' %}{% elif section.kind == 'agent' %}
{% include 'common/subagents_delegate_preamble.en.jinja' %}{% endif %}{{ items(section.ungrouped, section.kind == 'tool') }}{% for group in section.groups %}

#### {{ group.name }} {{ noun_plural }}{% if group.description %}

{{ group.description }}{% endif %}
{% set prefix = group.prefix %}{% include 'common/capabilities_prefix_note.en.jinja' %}
{{ items(group.entries, section.kind == 'tool') }}{% endfor %}{% if not loop.last %}

{% endif %}{% endfor %}
