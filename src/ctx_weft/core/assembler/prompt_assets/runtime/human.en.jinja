{# 人工交互、授权与无人值守；runtime 和 capability_gateway 在对应事件发生时插入。
每个具名 macro 是一个独立事件提示，参数就是输入契约；文件本身不整段发送。 #}

{% macro authorizer_needs_human_unsupported(authorizer) -%}
[Error: {{ authorizer }} returned NeedsHuman but does not implement HumanGatedAuthorizer]
{%- endmacro %}

{% macro provider_needs_human_unsupported(provider) -%}
[Error: {{ provider }} yielded needs_human but does not implement HumanResumable]
{%- endmacro %}

{% macro blocked_by_human(message) -%}
[Blocked by human: {{ message }}]
{%- endmacro %}

{% macro capability_not_authorized(tool) -%}
[Error: capability '{{ tool }}' not authorized]
{%- endmacro %}

{% macro unattended_authz_note() -%}
this task runs unattended in the background — there is nobody who could approve this tool call, so it is denied. Continue without it, or finish the task and say what you could not do.
{%- endmacro %}

{% macro unattended_tool_note() -%}
[No human available: this task runs unattended in the background, so nobody can respond. Continue with what you already know, or finish the task and state what blocked you.]
{%- endmacro %}

{% macro human_note(note, result) -%}
[Human note: {{ note }}]
{{ result }}
{%- endmacro %}

{% macro human_declined(message) -%}
Human declined: {{ message }}
{%- endmacro %}

{% macro human_rejected() -%}
Human rejected the request.
{%- endmacro %}

{% macro no_response() -%}
(no response)
{%- endmacro %}

