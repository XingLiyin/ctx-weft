{# 工具调用和结果包装；capability_gateway / act / observing 使用。工具自身的正文不在这里。
每个具名 macro 是一个独立事件提示，参数就是输入契约；文件本身不整段发送。 #}

{% macro unknown_tool(tool) -%}
[Error: unknown tool '{{ tool }}']
{%- endmacro %}

{% macro provider_missing(capability) -%}
[Error: no provider found for '{{ capability }}']
{%- endmacro %}

{% macro gateway_missing(tool) -%}
[Error: CapabilityGateway not configured, tool '{{ tool }}' skipped]
{%- endmacro %}

{% macro invalid_json_args(excerpt, tool) -%}
[Error: invalid arguments for '{{ tool }}': arguments were not valid JSON and could not be parsed. You sent: {{ excerpt }} — re-send the call with a well-formed JSON arguments object]
{%- endmacro %}

{% macro invalid_arguments(error, tool) -%}
[Error: invalid arguments for '{{ tool }}': {{ error }}]
{%- endmacro %}

{% macro tool_stream_error(code, message) -%}
[Error {{ code }}: {{ message }}]
{%- endmacro %}

{% macro tool_output_truncated(head, original_length, recovery, tail, threshold) -%}
[Tool output truncated: {{ original_length }} chars exceeded {{ threshold }}-char limit. {{ recovery }}]
--- preview (first {{ head | length }} chars) ---
{{ head }}{% if tail %}
--- tail (last {{ tail | length }} chars) ---
{{ tail }}{% endif %}
{%- endmacro %}

{% macro spill_unrecoverable() -%}
Full text is NOT recoverable (no spill sink configured, or the spill failed) — what follows is all that remains.
{%- endmacro %}

{% macro no_output() -%}
(no output)
{%- endmacro %}

