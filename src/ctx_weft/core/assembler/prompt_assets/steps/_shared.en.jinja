  'tool': ('### Available Tools (use them via tool calls)', 'calling', 'tool', 'tools'),
  'agent': ('### Available Sub-Agents', 'delegating', 'sub-agent', 'sub-agents')
} -%}
{% for section in sections %}
{% set heading, action, noun, noun_plural = vocabulary[section.kind] -%}
{{ heading }}{% if section.kind == 'tool' %}
