When {{ action }} these {{ noun_plural }}, prefix the {{ noun }} name with `{{ group.prefix }}`, exactly as shown below.
{{ capability_items(group.entries, section.kind == 'tool') }}{% endfor %}{% if not loop.last %}

{% endif %}{% endfor %}{% endif %}
