Delegate via: {{ delegate_task }}(use_subagent=True, subagent_template='<name>'){% endif %}{{ capability_items(section.ungrouped, section.kind == 'tool') }}{% for group in section.groups %}

#### {{ group.name }} {{ noun_plural }}{% if group.description %}

