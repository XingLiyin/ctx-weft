{
  "name": "task-canceled",
  "description": "取消路径：task 状态由 TaskCanceled 驱动（→ CANCELED）。注意 RunCanceled 在 reducer 中是 no-op——session 取消须经 SessionStatusChanged。本用例锁定该真相。",
  "runId": "s1",
  "events": [
    { "id": "evt_0001", "runId": "run_1", "sequence": 1, "sessionId": "s1",
      "type": "SessionCreated", "timestamp": "2026-06-05T00:00:01Z",
      "payload": { "user_prompt": "do it", "template_id": "tmpl_a", "root_agent_id": "agt_root" } },
    { "id": "evt_0002", "runId": "run_1", "sequence": 2, "sessionId": "s1",
      "type": "TaskCreated", "timestamp": "2026-06-05T00:00:02Z",
      "payload": { "task": { "id": "tsk_1", "status": "PENDING", "title": "T1", "assigned_agent_id": "agt_root", "creator_agent_id": "agt_root" } } },
    { "id": "evt_0003", "runId": "run_1", "sequence": 3, "sessionId": "s1", "taskId": "tsk_1",
      "type": "TaskStarted", "timestamp": "2026-06-05T00:00:03Z", "payload": { "assigned_agent_id": "agt_root" } },
    { "id": "evt_0004", "runId": "run_1", "sequence": 4, "sessionId": "s1",
      "type": "RunCanceled", "timestamp": "2026-06-05T00:00:04Z", "payload": {} },
    { "id": "evt_0005", "runId": "run_1", "sequence": 5, "sessionId": "s1", "taskId": "tsk_1",
      "type": "TaskCanceled", "timestamp": "2026-06-05T00:00:05Z", "payload": {} }
  ],
  "expected": {
    "sessionStatus": "RUNNING",
    "taskStatus": "CANCELED",
    "tasks": { "tsk_1": { "status": "CANCELED" } }
  }
}
